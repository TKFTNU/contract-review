# 模型服务配置模板：复制为 .env 后按需修改。
# 所有键均可省略；省略时使用内置默认值（与本文件中的示例一致）。
# 优先级（高到低）：命令行参数（--endpoint 等） > 真实环境变量 > .env > 内置默认值。

# ---- LM Studio（OpenAI 兼容接口）----
# 条款切分 / 要素抽取 / 一致性审查 / 法律裁判共用这一组。
CONTRACT_LLM_ENDPOINT=http://localhost:12345
CONTRACT_LLM_MODEL=qwen3.8-27b-nvfp4-mtp
CONTRACT_LLM_API_KEY=

# 单批超时（秒）。不设置时各客户端使用各自默认值（300；边界复核 120）。
# CONTRACT_LLM_TIMEOUT=300

# ---- Ollama（法条检索的 BGE-M3 向量）----
# 注意：修改 CONTRACT_EMBED_MODEL 后需要重建索引：
#   python scripts/build_legal_index.py
CONTRACT_OLLAMA_ENDPOINT=http://localhost:11434
CONTRACT_EMBED_MODEL=bge-m3
# 本地部署留空；若 embedding 服务位于需要 Bearer Token 的网关后则填写。
CONTRACT_EMBED_API_KEY=
